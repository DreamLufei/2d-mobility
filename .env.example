# Copy this file to .env for shared non-secret defaults.
# Put real secrets such as API keys in .env.local.

# --- Required LLM runtime settings ---
LLM_PROVIDER=openai
# Qwen/DashScope example: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenRouter fallback example: https://openrouter.ai/api/v1
# Structured agent calls use JSON mode internally; no separate json_schema toggle is needed.
LLM_BASE_URL=__FILL_ME__
LLM_API_KEY=__FILL_ME__
# Example model ids: qwen3.6-plus, minimax/minimax-m2.7
LLM_MODEL=__FILL_ME__
LLM_USE_RESPONSES_API=false
LLM_REASONING_EFFORT=

# Optional per-role model overrides. If omitted, roles inherit from LLM_MODEL.
ORCHESTRATOR_MODEL=
PLANNER_MODEL=
RECOVERY_MODEL=
CRITIC_MODEL=
PHYSICS_JUDGE_MODEL=
COST_GUARDIAN_MODEL=
REPORTER_MODEL=
EXECUTOR_MODEL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=600
HITL_POLICY=interactive
HUMAN_REVIEW_TIMEOUT_SECONDS=300
HUMAN_REVIEW_DEFAULT_ACTION=skip_material

MAX_REFINEMENT_ROUNDS=1
STRAIN_MIN_POINTS=5
STRAIN_TARGET_POINTS=7
FIT_R2_THRESHOLD=0.90

# --- Cluster/VASP execution settings ---
# Example:
# VASP_CMD=mpirun -np 4 vasp_std > sout 2>&1
VASP_CMD=
OMP_NUM_THREADS=
CUDA_VISIBLE_DEVICES=

# Optional Anthropic-style skill package configuration
MOBILITY_SKILLS_ROOT=
SKILL_AUTO_RESOLVE_LIMIT=6
SKILL_INLINE_BODY_LIMIT=2400

# --- Required Postgres + RAG settings ---
# Example:
# MOBILITY_DB_URI=postgresql://postgres:postgres@127.0.0.1:5432/mobility_agent
MOBILITY_DB_URI=__FILL_ME__
# Qwen/DashScope example: text-embedding-v4.
# You can keep embeddings on OpenRouter only when using the OpenRouter fallback route.
EMBEDDING_MODEL=__FILL_ME__
# Optional override; if empty, embeddings reuse LLM_BASE_URL
EMBEDDING_BASE_URL=
# Optional override; if empty, embeddings reuse LLM_API_KEY
EMBEDDING_API_KEY=
# Optional override for Wiki QA answers; if empty, reuses LLM_MODEL
WIKI_QA_MODEL=
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_REINDEX_BATCH_SIZE=64

# --- Optional agentic VASP policy layer ---
# Planner/recovery agents retrieve bundled house-policy and VASP Wiki evidence
# from Postgres + pgvector, then propose bounded INCAR/KPOINTS overrides for
# VASP-writing stages.
AGENTIC_POLICY_ENABLED=true
# v1 supports only the restricted allowlist mode.
POLICY_ALLOWLIST_MODE=restricted
POLICY_RETRIEVAL_TOP_K=5
POLICY_TRACE_ENABLED=true

# --- Optional human-escalation email settings ---
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_NOTIFY_TO=
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_FROM=
SMTP_PASSWORD=

# --- Optional web-console shell helper settings ---
# The safer default is localhost-only. Set WEB_CONSOLE_HOST=0.0.0.0
# only when you intentionally want LAN/public access and have your own
# network-layer protection.
WEB_CONSOLE_HOST=127.0.0.1
WEB_CONSOLE_PORT=8765
# Colon-separated list, for example:
# WEB_CONSOLE_JOB_ROOTS=/data/material_runs:/data/batch_runs
WEB_CONSOLE_JOB_ROOTS=

# Optional batch settings
MONGO_URI=__FILL_ME__
MONGO_DB=materials_database
MONGO_COLLECTION=Vertical_NM_Sample_20
MONGO_CLAIM_FILTER_JSON=
BATCH_TAG=batch_run
RUNS_ROOT=__FILL_ME__
